# Fund Analyzer — variables de entorno
# Copiar este fichero a `.env` y rellenar.

# === API KEYS (obligatorias) ===

# Claude (Anthropic) — usado por analyst_agent + manager_profiler enrichment + audit
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (Google AI) — usado por extractor INT v3 + structured extraction
GOOGLE_API_KEY=AIza...

# Serper.dev — Google Search API para discovery + readings + manager
SERPER_API_KEY=...

# Opcional: Google Custom Search Engine (fallback de Serper)
# GOOGLE_CSE_API_KEY=AIza...
# GOOGLE_CSE_CX=...

# === OPTIMIZACIÓN DE COSTE (recomendado configurar) ===

# Cache LLM local: ON por default (TTL 24h). Re-runs con mismo prompt → cache hit FREE.
# Solo setear a 1 si necesitas refresh forzado.
# LLM_CACHE_DISABLED=1

# Skip secciones ya pobladas en analyst (re-runs parciales). Recomendado ON.
SKIP_EXISTING_SECTIONS=1

# Quality loop: 1 iter es óptimo coste/valor según análisis Mayo 2026.
# Solo subir para fondos problemáticos.
QUALITY_LOOP_MAX_ITER=1

# Sonnet como T1 default (calidad alta para narrative). Default ON.
# Setear a "false" para usar solo Gemini Flash (más barato, calidad menor).
USE_SONNET=true

# Fallback Anthropic cuando Gemini falla (403/PERMISSION_DENIED). Recomendado ON.
GEMINI_FALLBACK_ANTHROPIC=1

# === COSTE PROYECTADO (post Cost-Opt + Fase M) ===
# - Pipeline ES nuevo (cache vacío):      $0.15-0.30
# - Pipeline INT nuevo (cache vacío):     $0.30-0.50
# - Re-ejecutar mismo fondo (cache hit):  $0.01-0.05
# - Regenerar 1 sección con SKIP=1:       $0.01-0.02
#
# Para 50 fondos nuevos/mes: ~€10-20/mes.
