{
  // Worker fund-analyzer — sirve ./dashboard/ como Static Assets + routing FONDO vs CLASE.
  //
  // Modo AVANZADO (worker/index.js sobre static assets):
  //   /fund-{ISIN}  →  si el ISIN es una clase de un grupo multi-clase, sirve el HTML del
  //                    PRIMARIO del grupo (último análisis bueno) con el contexto de la clase
  //                    inyectado (cabecera + selector). Ver worker/index.js + tools/build_class_map.py.
  //   Cualquier otra ruta / fondo mono-clase → asset estático normal (env.ASSETS.fetch).
  //
  // URL resultante: https://fund-analyzer.<subdominio>.workers.dev/fund-{ISIN}
  // Deploy automático: cada push al branch conectado en Cloudflare (bundle de worker/index.js).
  "name": "fund-analyzer",
  "compatibility_date": "2025-05-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    // sirve /fund-XXXX -> fund-XXXX.html y rutas limpias
    "html_handling": "auto-trailing-slash",
    // si no existe el archivo y el worker no routea, 404 simple
    "not_found_handling": "404-page",
    // CLAVE: por defecto CF sirve el asset directo SIN invocar el worker cuando el fichero existe
    // → una clase con su propio HTML (stale) se servía sin routear al primario. Con esto el worker
    // corre PRIMERO en /fund-* y decide (routea alias→primario o cae al asset con env.ASSETS.fetch).
    "run_worker_first": ["/fund-*"]
  }
}
